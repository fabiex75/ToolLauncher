cked","group":"navigation@3","when":"view == axet-plugin.SidebarProvider"},{"command":"axet.popoutButtonClicked","group":"navigation@4","when":"view == axet-plugin.SidebarProvider"},{"command":"axet.accountButtonClicked","group":"navigation@5","when":"view == axet-plugin.SidebarProvider"},{"command":"axet.settingsButtonClicked","group":"navigation@6","when":"view == axet-plugin.SidebarProvider"}],"editor/title":[{"command":"axet.plusButtonClicked","group":"navigation@1","when":"activeWebviewPanelId == axet-plugin.TabPanelProvider"},{"command":"axet.historyButtonClicked","group":"navigation@3","when":"activeWebviewPanelId == axet-plugin.TabPanelProvider"},{"command":"axet.popoutButtonClicked","group":"navigation@4","when":"activeWebviewPanelId == axet-plugin.TabPanelProvider"},{"command":"axet.accountButtonClicked","group":"navigation@5","when":"activeWebviewPanelId == axet-plugin.TabPanelProvider"},{"command":"axet.settingsButtonClicked","group":"navigation@6","when":"activeWebviewPanelId == axet-plugin.TabPanelProvider"}],"editor/context":[{"command":"axet.addToChat","group":"navigation","when":"editorHasSelection"}],"terminal/context":[{"command":"axet.addTerminalOutputToChat","group":"navigation"}]},"configuration":{"title":"axet.plugin","properties":{"axet.vsCodeLmModelSelector":{"type":"object","properties":{"vendor":{"type":"string","description":"The vendor of the language model (e.g. copilot)"},"family":{"type":"string","description":"The family of the language model (e.g. gpt-4)"}},"description":"Settings for VSCode Language Model API"},"axet.enableCheckpoints":{"type":"boolean","default":true,"description":"Enables extension to save checkpoints of workspace throughout the task. Uses git under the hood which may not work well with large workspaces."},"axet.disableBrowserTool":{"type":"boolean","default":false,"description":"Disables extension from spawning browser session."},"axet.modelSettings.o3Mini.reasoningEffort":{"type":"string","enum":["low","medium"